<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Категория и описание операции (название магазина). Одна запись на транзакцию. -->
    <changeSet id="007--create-table-transaction-details" author="student">
        <createTable tableName="transaction_details" schemaName="${APP_DATABASE_SCHEMA}">
            <column name="transaction_id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_transaction_details" nullable="false"/>
            </column>
            <column name="category" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="transaction_details"
                     schemaName="${APP_DATABASE_SCHEMA}"
                     indexName="idx_transaction_details_category">
            <column name="category"/>
        </createIndex>
    </changeSet>

    <!-- Внешний ключ на таблицу транзакций (transaction.id — uuid). -->
    <changeSet id="007--transaction-details-fk" author="student">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="transaction" schemaName="${APP_DATABASE_SCHEMA}"/>
        </preConditions>
        <addForeignKeyConstraint baseTableName="transaction_details"
                                 baseTableSchemaName="${APP_DATABASE_SCHEMA}"
                                 baseColumnNames="transaction_id"
                                 referencedTableName="transaction"
                                 referencedTableSchemaName="${APP_DATABASE_SCHEMA}"
                                 referencedColumnNames="id"
                                 constraintName="fk_transaction_details_transaction"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
